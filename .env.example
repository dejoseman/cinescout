# ---------------------------------------------------------------------------
# CineScout environment configuration
#
# Copy to .env for local development. Never commit a filled-in .env.
# In production these are injected from Google Cloud Secret Manager.
# ---------------------------------------------------------------------------

# --- Parallel Search API (required) ----------------------------------------
# CineScout's only source of external world knowledge. Without it the pipeline
# refuses to run rather than producing a report from model recall.
# Get a key at https://parallel.ai
PARALLEL_API_KEY=

# Search tier: basic | fast | turbo | advanced.
# Measured against the live API: "basic" ~1.7s and returned the most excerpt
# text; "advanced" ~2.8s; "turbo" ~1.0s but thinner. "basic" is the default
# because the evidence stage needs excerpt volume, not just URLs.
# Note: the v1beta value "base" is NOT valid on v1 and is auto-corrected.
PARALLEL_MODE=basic
PARALLEL_MAX_RESULTS=6
PARALLEL_MAX_CHARS=1500
PARALLEL_MAX_CONCURRENCY=5
PARALLEL_TIMEOUT_S=45

# --- Google Gemini (required) ----------------------------------------------
# Option A: Gemini Developer API. Get a key at https://aistudio.google.com
GOOGLE_API_KEY=

# Option B: Vertex AI / Gemini Enterprise Agent Platform, using ADC.
# Set these instead of GOOGLE_API_KEY and run `gcloud auth application-default login`.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Workhorse model for all eight stages.
GEMINI_MODEL=gemini-3.7-flash

# Optionally raise the judgement-dense stages (verification, risk,
# recommendation, report) to a heavier model.
# GEMINI_REASONING_MODEL=gemini-3.1-pro-preview

# --- Pipeline limits (bound latency and spend) ------------------------------
MAX_RESEARCH_TASKS=8
MAX_CONCURRENT_PIPELINES=3
MAX_EVIDENCE_CHARS=60000

# --- API --------------------------------------------------------------------
RATE_LIMIT_PER_HOUR=20
LOG_LEVEL=INFO
# Only needed when the frontend is served from a different origin (dev mode).
# CORS_ORIGINS=http://localhost:5173
